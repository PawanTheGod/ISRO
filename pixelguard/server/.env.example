# PixelGuard Server — Environment Configuration
# Copy this file to .env and fill in your API credentials.
# The server reads PG_PROVIDER, PG_API_KEY, PG_API_URL, PG_MODEL from environment.
#
# DEFAULT (recommended for demo): hosted cloud VLM API
# This gives 2-4s latency instead of 9s with local Ollama.

# Provider: hosted | ollama | stub
PG_PROVIDER=hosted

# Cloud VLM API (OpenAI-compatible chat/completions endpoint)
# Examples:
#   Qwen2-VL on DashScope:     https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
#   LLaVA on HuggingFace:      https://api-inference.huggingface.co/models/llava-hf/llava-1.5-7b-hf
#   Together.ai:               https://api.together.xyz/v1/chat/completions
PG_API_KEY=your-api-key-here
PG_API_URL=https://api.provider.com/v1/chat/completions

# Model name (depends on your provider)
PG_MODEL=Qwen/Qwen2-VL-7B-Instruct

# ── Alternative: Local Ollama (offline, ~9s latency) ──
# PG_PROVIDER=ollama
# PG_MODEL=llava
# OLLAMA_URL=http://localhost:11434

# ── Alternative: Stub (no VLM, deterministic planner, 0ms) ──
# PG_PROVIDER=stub
