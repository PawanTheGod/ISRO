{
  "manifest_version": 3,
  "name": "PixelGuard",
  "version": "0.1.0",
  "description": "Privacy-first visual perception for browser agents — on-device PII detection, redaction, and VLM action selection.",
  "browser_specific_settings": {
    "gecko": {
      "id": "pixelguard@sih26171.team",
      "strict_min_version": "115.0"
    }
  },
  "permissions": ["tabs", "scripting", "storage", "activeTab"],
  "host_permissions": ["http://localhost:8080/*", "http://localhost:8000/*", "http://127.0.0.1/*"],
  "background": { "scripts": ["browser-polyfill.js", "background.js"], "type": "module" },
  "action": { "default_title": "PixelGuard Console" },
  "content_scripts": [
    { "matches": ["http://localhost:8080/*"], "js": ["browser-polyfill.js", "content.js"], "run_at": "document_idle" }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "console.html", "console.css", "console.js",
        "detection.js", "redaction.js", "vision.js", "payload.js", "profile.js", "resource_monitor.js",
        "ner.js", "ocr.js", "browser-polyfill.js",
        "vendor/tasks-vision/*", "vendor/tasks-vision/wasm/*",
        "vendor/transformers/*", "vendor/tesseract/*",
        "models/*"
      ],
      "matches": ["http://localhost:8080/*", "http://localhost:8000/*", "http://127.0.0.1/*", "<all_urls>"]
    }
  ],
  "content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'" }
}
